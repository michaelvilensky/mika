# Copy to .env and fill in. .env is gitignored.

# Claude API key from https://console.anthropic.com (or leave unset if you use `ant auth login`)
ANTHROPIC_API_KEY=

# Personal Gmail + a Gmail *App Password* (requires 2-Step Verification):
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Shared secret between the bridge and the digest job. Generate with:  openssl rand -hex 24
BRIDGE_TOKEN=
BRIDGE_PORT=4873
